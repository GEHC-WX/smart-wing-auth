{
  "name": "@smart-wing/auth",
  "version": "0.2.0",
  "description": "Smart Wing 平台共享认证包",
  "license": "UNLICENSED",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/jwt": "^10 || ^11",
    "@nestjs/core": "^10 || ^11"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/jwt": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "@nestjs/core": "^10.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!index.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}